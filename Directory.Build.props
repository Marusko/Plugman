<Project>

  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Absolute anchors so plugin/fixture copy targets never depend on the CWD. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <PluginsRoot>$(RepoRoot)plugins\</PluginsRoot>
    <TestPluginsRoot>$(RepoRoot)artifacts\test-plugins\</TestPluginsRoot>

    <Version>1.0.0</Version>
    <Authors>Plugman</Authors>
    <Product>Plugman</Product>
  </PropertyGroup>

</Project>
