<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Plugman.Sample.ConsoleHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The "no UI dependency" proof: this host references Plugman.Contracts and Plugman.Core and
      nothing else from Plugman. It builds and runs with no WPF and no Blazor anywhere in its
      closure, on any platform.
    -->
    <ProjectReference Include="..\..\src\Plugman.Contracts\Plugman.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Plugman.Core\Plugman.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SamplePaths.cs" Link="SamplePaths.cs" />
  </ItemGroup>

</Project>
