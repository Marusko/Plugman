<Window x:Class="Plugman.Sample.WpfHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugman WPF host"
        Height="620"
        Width="1020">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Starting..." />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Left" Width="330" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,12,12,6">
                    <TextBlock Text="Plugins" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="RescanButton"
                            Content="Rescan"
                            Margin="12,0,0,0"
                            Padding="10,3"
                            Click="OnRescanClick" />
                </StackPanel>

                <ListBox x:Name="PluginList"
                         Margin="6"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,2" Background="#FAFAFA" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#666" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Status}" Foreground="#B00" FontSize="11" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Enable"
                                                Padding="10,2"
                                                Tag="{Binding Id}"
                                                Click="OnEnableClick" />
                                        <Button Content="Disable"
                                                Padding="10,2"
                                                Margin="6,0,0,0"
                                                Tag="{Binding Id}"
                                                Click="OnDisableClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--
            Every tab in here is a FrameworkElement a plugin built. The host has no idea what
            is inside them: no DataTemplates, no view models, no per-plugin code.
        -->
        <TabControl x:Name="PluginTabs" Margin="8" />
    </DockPanel>
</Window>
